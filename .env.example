# ==========================================
# DeployMate-II Environment Configuration
# ==========================================

# Database
POSTGRES_DB=deploymate
POSTGRES_USER=deploymate
POSTGRES_PASSWORD=deploymate_dev
DATABASE_URL=postgresql://deploymate:deploymate_dev@postgres:5432/deploymate

# Security
SECRET_KEY=deploymate-dev-secret-change-in-production

# Amazon Bedrock AI (Optional locally, IAM Role used on EC2)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# Set these if running locally without IAM Role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
